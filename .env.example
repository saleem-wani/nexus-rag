# ====================================================
# Nexus RAG Environment Configuration
# ====================================================

# Port Configuration
FRONTEND_PORT=5173
BACKEND_PORT=8001
POSTGRES_PORT=5434

# PostgreSQL Database
POSTGRES_DB=nexus_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Embedding Settings
# Providers: "fastembed" (local CPU, default, no API key required), "openai", "gemini", "ollama"
DEFAULT_EMBEDDING_PROVIDER=fastembed
ALLOWED_ORIGINS=["http://localhost:5173"]
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# LLM Providers & API Keys
# Providers: "openai", "gemini", "ollama"
DEFAULT_LLM_PROVIDER=openai

# OpenAI API (Optional if using Gemini or Ollama)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API (Optional if using OpenAI or Ollama)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Ollama Local LLM (Optional if using local Ollama model)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# RAG Ingestion & Retrieval Hyperparameters
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.2
SOURCE_RELEVANCE_MARGIN=0.1
RAGAS_DO_NOT_TRACK=true

