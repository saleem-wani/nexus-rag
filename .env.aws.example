# Copy to .env.aws on the EC2 instance. Never commit .env.aws.
POSTGRES_DB=nexus_rag
POSTGRES_USER=nexus
# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=replace-with-a-random-hex-password

# The frontend and API share one origin behind Nginx.
ALLOWED_ORIGINS=["http://localhost"]

DEFAULT_EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.2
SOURCE_RELEVANCE_MARGIN=0.1
MAX_UPLOAD_FILE_SIZE=26214400
MAX_UPLOAD_BATCH_SIZE=104857600
MAX_UPLOAD_FILES=10
